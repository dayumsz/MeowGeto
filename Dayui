

local APBreaker = {}

---@module Utility.Configuration
local Configuration = require("Utility/Configuration")

---@module Game.Timings.SaveManager
local SaveManager = require("Game/Timings/SaveManager")

local target_anims = {
    "rbxassetid://9657469282",
    "rbxassetid://6055558740",
    "rbxassetid://128614295452457",
    "rbxassetid://7599155704",
    "rbxassetid://10168663111",
    "rbxassetid://15302935464",
    "rbxassetid://5053295423",
    "rbxassetid://6385078248",
    "rbxassetid://7968088101",
}

local lastApTick = 0

local function getNukerAnimationId()
    local known = {}

    if SaveManager and SaveManager.as then
        for _, timing in next, SaveManager.as:list() do
            local id = timing:id()
            if id and #id > 0 then
                known[#known + 1] = tostring(id)
            end
        end
    end

    if #known > 0 then
        return known[math.random(1, #known)]
    end 

    return target_anims[math.random(1, #target_anims)]
end

---Update the AP Breaker by playing a spoofed animation.
---@param rootPart BasePart
---@param humanoid Humanoid
---@param dt number
function APBreaker.update(rootPart, humanoid, dt)
    if tick() - lastApTick < 1 / 8 then
        return
    end
    lastApTick = tick()

    if not humanoid then
        return
    end

    local animation_instance = Instance.new("Animation")
    animation_instance.AnimationId = getNukerAnimationId()

    local track = humanoid:LoadAnimation(animation_instance)
    track:Play(9999999, math.random() + 0.7, (math.random() + 0.5) * 2.86)

    task.delay(0.3, function()
        if track then
            track:Stop()
            track:Destroy()
        end
    end)

    track.Ended:Once(function()
    end)
end

return APBreaker
